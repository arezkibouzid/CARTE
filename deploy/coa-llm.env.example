# COA-Net and the locally deployed model. Copy to coa-llm.env, then: set -a; . deploy/coa-llm.env; set +a
COA_LLM_BASE_URL=http://127.0.0.1:8000/v1     # vLLM or llama.cpp started by serve_*.sh; Ollama: http://127.0.0.1:11434/v1
# COA_LLM_MODEL=mistral-small-3.2             # unset: COA-Net takes the model the server lists; with Ollama, the tag
COA_LLM_JSON_SCHEMA=1                         # 0 if `coa-net llm-check` says the server ignores the schema
COA_LLM_TIMEOUT=120                           # seconds per call before the role falls back
COA_LLM_CONNECT_TIMEOUT=5                     # seconds to reach the server
COA_LLM_LOG=outputs/llm_log.jsonl             # prompts and answers, kept on this machine (images left out)
# COA_LLM_ALLOW_REMOTE=1                      # only to accept an endpoint outside this machine and its private network
